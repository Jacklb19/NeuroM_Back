# Copiar a .env para desarrollo local (nunca versionar .env).
# Solo nombres de variables: los valores reales viven en .env y en las variables de entorno de Vercel.

# Supabase: la clave de servicio solo existe en el servidor.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Modelo de lenguaje (ADR-08).
GROQ_API_KEY=

# Orígenes del frontend autorizados por CORS, separados por comas.
ALLOWED_ORIGINS=
